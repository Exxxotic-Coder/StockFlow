# MongoDB Connection URL
MONGO_URL=mongodb://127.0.0.1:27017/stockflow

# Google Gemini API Key for the AI Portfolio Assistant
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Backend Server Port
PORT=3002

# Comma-separated frontend origins. Use HTTPS origins in production.
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001

# Use a long random value (at least 32 characters) in production.
SESSION_SECRET=replace-with-a-long-random-secret

# Set to production only when deployed behind HTTPS.
NODE_ENV=development
